;;; Build script for the pam-audit standalone engine.
(in-package #:cl-user)
(setf sb-ext:*evaluator-mode* :compile)
(declaim (optimize (speed 3) (safety 1) (debug 0) (space 0)))
(require "asdf")
(require "sb-posix")
(let ((v (sb-ext:posix-getenv "XDG_DATA_DIRS")))
  (when v
    (let ((parts (loop for s in (uiop:split-string v :separator ":")
                       when (and (> (length s) 0) (char= (char s 0) #\/))
                       collect s)))
      (sb-posix:setenv "XDG_DATA_DIRS" (format nil "~{~a~^:~}" parts) 1))))
(let* ((this-file (or *load-truename* (truename "lisp/build.lisp")))
       (lisp-dir (make-pathname :directory (pathname-directory this-file) :name nil :type nil))
       (root-dir (merge-pathnames "../" lisp-dir))
       (out-path (merge-pathnames "bin/pam-audit" root-dir)))
  (pushnew lisp-dir asdf:*central-registry* :test #'equal)
  (asdf:load-asd (merge-pathnames "pam-audit.asd" lisp-dir))
  (asdf:load-system :pam-audit)
  (ensure-directories-exist out-path)
  (let ((entry (or (find-symbol "ENTRY" "PAM-AUDIT.CORE")
                   (error "pam-audit build: ENTRY not found in PAM-AUDIT.CORE"))))
    (format t "BUILD: writing ~a~%" (namestring out-path))
    (finish-output)
    (setf (symbol-value (find-symbol "*STANDALONE-P*" "PAM-AUDIT.CORE")) t)
    (sb-ext:save-lisp-and-die (namestring out-path) :toplevel entry :executable t :compression t :save-runtime-options t)))
