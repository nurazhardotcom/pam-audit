;;;; http.lisp --- Minimal HTTP/1.1 client on SBCL sockets + curl for https.
(in-package #:pam-audit.http)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (require :sb-bsd-sockets))
(defun inet-socket-class () (find-class 'sb-bsd-sockets:inet-socket))
(defstruct (response (:constructor make-response (status body &optional headers)))
  (status 0 :type integer)
  (body "" :type string)
  (headers (make-hash-table :test 'equal) :type hash-table))
(defstruct (endpoint (:constructor make-endpoint (scheme host port path)))
  scheme host port path)
(defun parse-url (url)
  (let* ((colon (search "://" url))
         (scheme (string-downcase (subseq url 0 colon)))
         (rest (subseq url (+ colon 3)))
         (slash (or (position #\/ rest) (length rest)))
         (authority (subseq rest 0 slash))
         (path (if (< slash (length rest)) (subseq rest slash) "/"))
         (port-pos (position #\: authority))
         (host (if port-pos (subseq authority 0 port-pos) authority))
         (port (cond (port-pos (or (parse-integer-or-nil (subseq authority (1+ port-pos))) 80))
                     ((string= scheme "https") 443)
                     (t 80))))
    (unless (member scheme '("http" "https") :test #'string=)
      (app-error* (format nil "unsupported URL scheme '~a'" scheme) (list :url url)))
    (when (zerop (length host))
      (app-error* "URL has no host" (list :url url)))
    (make-endpoint scheme host port path)))
(defun base64-encode-string (string)
  (let* ((bytes (sb-ext:string-to-octets string :external-format :utf-8))
         (alpha "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
         (len (length bytes))
         (out (make-string (* 4 (ceiling len 3)))))
    (loop with oi = 0 for i from 0 below len by 3
          do (let* ((b0 (aref bytes i))
                    (b1 (if (< (1+ i) len) (aref bytes (1+ i)) 0))
                    (b2 (if (< (+ i 2) len) (aref bytes (+ i 2)) 0))
                    (tri (+ (ash b0 16) (ash b1 8) b2)))
               (setf (char out oi) (char alpha (ldb (byte 6 18) tri))
                     (char out (1+ oi)) (char alpha (ldb (byte 6 12) tri))
                     (char out (+ oi 2)) (if (< (1+ i) len) (char alpha (ldb (byte 6 6) tri)) #\=)
                     (char out (+ oi 3)) (if (< (+ i 2) len) (char alpha (ldb (byte 6 0) tri)) #\=))
               (incf oi 4)))
    out))
(defun url-encode (string)
  (with-output-to-string (out)
    (loop for ch across string
          do (if (or (alphanumericp ch) (find ch "-._~" :test #'char=))
                 (write-char ch out)
                 (format out "%~2,'0X" (char-code ch))))))
(defun parse-status-code (line)
  (let ((parts (uiop:split-string (or line "") :separator '(#\Space))))
    (or (and (second parts) (parse-integer-or-nil (second parts))) 0)))
(defun read-headers (stream)
  (loop for line = (read-line stream nil nil)
        while (and line (> (length (string-trim '(#\Return #\Newline #\Space #\Tab) line)) 0))
        collect (let* ((clean (string-trim '(#\Return #\Newline) line))
                       (colon (position #\: clean)))
                  (when colon
                    (cons (string-downcase (string-trim '(#\Space #\Tab) (subseq clean 0 colon)))
                          (string-trim '(#\Space #\Tab #\Return) (subseq clean (1+ colon))))))
        into hs finally (return (remove nil hs))))
(defun read-fixed-string (stream n)
  (let ((buf (make-string n)) (pos 0))
    (loop while (< pos n) for c = (read-char stream nil nil) while c
          do (setf (char buf pos) c) (incf pos))
    (if (< pos n) (subseq buf 0 pos) buf)))
(defun read-to-eof-string (stream)
  (with-output-to-string (out)
    (loop for c = (read-char stream nil nil) while c do (write-char c out))))
(defun socket-request (method url &key body headers)
  (let* ((ep (parse-url url))
         (host (endpoint-host ep)) (port (endpoint-port ep)) (path (endpoint-path ep))
         (sock (make-instance (inet-socket-class) :type :stream :protocol :tcp))
         (addr (sb-bsd-sockets:host-ent-address (sb-bsd-sockets:get-host-by-name host))))
    (sb-bsd-sockets:socket-connect sock addr port)
    (let ((stream (sb-bsd-sockets:socket-make-stream sock :input t :output t :element-type 'character :external-format :utf-8)))
      (unwind-protect
           (progn
             (write-string (format nil "~a ~a HTTP/1.1~c~c" method path #\Return #\Newline) stream)
             (write-string (format nil "Host: ~a:~a~c~c" host port #\Return #\Newline) stream)
             (write-string (format nil "Accept: application/json~c~c" #\Return #\Newline) stream)
             (write-string (format nil "Connection: close~c~c" #\Return #\Newline) stream)
             (dolist (h headers) (write-string (format nil "~a: ~a~c~c" (car h) (cdr h) #\Return #\Newline) stream))
             (when body
               (write-string (format nil "Content-Length: ~a~c~c" (length (sb-ext:string-to-octets body :external-format :utf-8)) #\Return #\Newline) stream))
             (write-string (format nil "~c~c" #\Return #\Newline) stream)
             (when body (write-string body stream))
             (finish-output stream)
             (let* ((status-line (read-line stream nil ""))
                    (status (parse-status-code status-line))
                    (rh (read-headers stream))
                    (len-h (cdr (assoc "content-length" rh :test #'string=)))
                    (bstr (if len-h
                              (let ((n (or (parse-integer-or-nil len-h) 0)))
                                (if (> n 0) (read-fixed-string stream n) ""))
                              (read-to-eof-string stream)))
                    (tab (make-hash-table :test 'equal)))
               (dolist (p rh) (setf (gethash (car p) tab) (cdr p)))
               (make-response status bstr tab)))
        (ignore-errors (close stream))
        (ignore-errors (sb-bsd-sockets:socket-close sock))))))
(defun curl-request (method url &key body headers)
  (let ((args (append (list "-sS" "-X" method)
                      (mapcan (lambda (h) (list "-H" (format nil "~a: ~a" (car h) (cdr h)))) (or headers nil))
                      (when body (list "--data-binary" "@-"))
                      (list url "-w" "CURLSTATUS:%{http_code}"))))
    (let* ((proc (sb-ext:run-program "curl" args :search t :input (when body (make-string-input-stream body)) :output :stream :error nil :wait nil))
           (out (sb-ext:process-output proc))
           (text (with-output-to-string (s)
                   (loop for line = (read-line out nil nil) while line do (write-line line s)))))
      (sb-ext:process-wait proc)
      (let* ((m (search "CURLSTATUS:" text :from-end t))
             (code (if m (or (parse-integer-or-nil (string-trim '(#\Return #\Newline #\Space) (subseq text (+ m 11)))) 0) 0))
             (bstr (if m (subseq text 0 m) text)))
        (make-response code bstr (make-hash-table :test 'equal))))))
(defun request (method url &key body headers)
  (let ((scheme (endpoint-scheme (parse-url url))))
    (if (string= scheme "https")
        (curl-request method url :body body :headers headers)
        (socket-request method url :body body :headers headers))))
(defun http-get (url &key headers) (request "GET" url :headers headers))
(defun http-post (url &key body headers) (request "POST" url :body body :headers headers))
(defun write-all (octets stream) (write-sequence octets stream) (finish-output stream))
(defun read-all-bytes (stream)
  (let ((s (read-to-eof-string stream)))
    (sb-ext:string-to-octets s :external-format :utf-8)))
